# Server Configuration
PORT=3001
NODE_ENV=development

# Azure Cosmos DB Configuration
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE_ID=ApprovalsDB
COSMOS_CONTAINER_ID=ApprovalMetadata

# Authentication Method (choose one):
# Option 1: Use Azure AD (Managed Identity) - Recommended for Azure deployments
USE_AZURE_AD_AUTH=true
# Option 2: Use Key-based authentication - For local development
# COSMOS_KEY=your-primary-key-here

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Optional: Application Insights for monitoring
# APPINSIGHTS_INSTRUMENTATIONKEY=your-key-here
